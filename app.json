{
  "_comment": "This file is generated by hand for a from-scratch Homey SDK3 app. Edit this file, not a compose build output.",
  "id": "com.rickd.huum",
  "version": "0.5.2",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": ["local", "cloud"],
  "name": {
    "en": "HUUM Sauna (Full Control)",
    "de": "HUUM Sauna (Volle Kontrolle)"
  },
  "description": {
    "en": "Full sauna control — humidity, water alarm, timer and more — that the official app leaves out.",
    "de": "Volle Saunasteuerung — Luftfeuchtigkeit, Wasseralarm, Timer und mehr — die die offizielle App auslässt."
  },
  "category": ["climate"],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Richard Dubs"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "RickDch"
      }
    }
  },
  "brandColor": "#E85D2B",
  "source": "https://github.com/RickD-CH/com.rickd.huum",
  "bugs": {
    "url": "https://github.com/RickD-CH/com.rickd.huum/issues"
  },
  "capabilities": {
    "huum_time_remaining": {
      "type": "number",
      "title": {
        "en": "Time Remaining",
        "de": "Verbleibende Zeit"
      },
      "desc": {
        "en": "Minutes remaining until the heater automatically switches off.",
        "de": "Minuten, bis der Ofen automatisch ausschaltet."
      },
      "units": {
        "en": "min",
        "de": "min"
      },
      "min": 0,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "huum_finishing_soon",
        "title": {
          "en": "The sauna will be done heating soon",
          "de": "Die Sauna ist bald fertig geheizt"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          }
        ],
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes remaining",
              "de": "Verbleibende Minuten"
            },
            "example": 8
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "time_remaining_below",
        "title": {
          "en": "Remaining time !{{is|is not}} below",
          "de": "Restzeit !{{ist|ist nicht}} unter"
        },
        "titleFormatted": {
          "en": "Remaining time !{{is|is not}} below [[minutes]] minutes",
          "de": "Restzeit !{{ist|ist nicht}} unter [[minutes]] Minuten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Minutes",
              "de": "Minuten"
            },
            "min": 1,
            "max": 180,
            "value": 10
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "start_with_temperature_and_humidity",
        "title": {
          "en": "Start the sauna at !{{|}} temperature and humidity",
          "de": "Sauna mit Temperatur und Luftfeuchtigkeit starten"
        },
        "titleFormatted": {
          "en": "Start the sauna at [[temperature]] °C and [[humidity]] % humidity",
          "de": "Sauna mit [[temperature]] °C und [[humidity]] % Luftfeuchtigkeit starten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "range",
            "name": "temperature",
            "title": {
              "en": "Temperature (°C)",
              "de": "Temperatur (°C)"
            },
            "min": 40,
            "max": 110,
            "step": 1,
            "value": 80,
            "label": "°C"
          },
          {
            "type": "range",
            "name": "humidity",
            "title": {
              "en": "Humidity (%)",
              "de": "Luftfeuchtigkeit (%)"
            },
            "min": 0,
            "max": 90,
            "step": 5,
            "value": 30,
            "label": "%"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "uku",
      "name": {
        "en": "HUUM UKU Sauna Heater",
        "de": "HUUM UKU Saunaofen"
      },
      "class": "thermostat",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "target_humidity",
        "measure_humidity",
        "huum_time_remaining",
        "alarm_contact",
        "alarm_water",
        "alarm_generic"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 40,
          "max": 110,
          "step": 1,
          "decimals": 0
        },
        "target_humidity": {
          "min": 0,
          "max": 0.9,
          "step": 0.01
        },
        "alarm_contact": {
          "title": {
            "en": "Door open",
            "de": "Tür offen"
          }
        },
        "alarm_water": {
          "title": {
            "en": "No water in steamer",
            "de": "Kein Wasser im Verdampfer"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Emergency stop / problem",
            "de": "Notaus / Problem"
          }
        },
        "onoff.light": {
          "title": {
            "en": "Light",
            "de": "Licht"
          }
        }
      },
      "energy": {
        "approximation": {
          "usageOn": 6000,
          "usageOff": 0
        }
      },
      "platforms": ["local", "cloud"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/uku/assets/images/small.png",
        "large": "/drivers/uku/assets/images/large.png",
        "xlarge": "/drivers/uku/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "/drivers/uku/assets/icon.svg",
            "usernameLabel": {
              "en": "HUUM email address",
              "de": "HUUM E-Mail-Adresse"
            },
            "usernameHint": {
              "en": "The email address you use to log in to the HUUM app.",
              "de": "Die E-Mail-Adresse, mit der du dich in der HUUM-App anmeldest."
            },
            "passwordLabel": {
              "en": "HUUM password",
              "de": "HUUM Passwort"
            }
          },
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "HUUM email address",
              "de": "HUUM E-Mail-Adresse"
            },
            "passwordLabel": {
              "en": "HUUM password",
              "de": "HUUM Passwort"
            }
          }
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Notifications",
            "de": "Benachrichtigungen"
          },
          "children": [
            {
              "id": "notifyOnWaterAlarm",
              "type": "checkbox",
              "label": {
                "en": "Push notification when the steamer has no water",
                "de": "Push-Benachrichtigung, wenn dem Verdampfer Wasser fehlt"
              },
              "hint": {
                "en": "Sends a Homey notification the moment the steamer reports it needs to be refilled, in addition to the water alarm you can use in Flows.",
                "de": "Sendet eine Homey-Benachrichtigung, sobald der Verdampfer meldet, dass Wasser nachgefüllt werden muss — zusätzlich zum Wasseralarm, den du auch in Flows nutzen kannst."
              },
              "value": true
            },
            {
              "id": "finishingSoonThresholdMinutes",
              "type": "number",
              "label": {
                "en": "\"Finishing soon\" threshold",
                "de": "Schwelle für \"bald fertig\""
              },
              "hint": {
                "en": "How many minutes before automatic shut-off the \"sauna will be done heating soon\" Flow trigger should fire.",
                "de": "Wie viele Minuten vor dem automatischen Abschalten der Flow-Trigger \"Sauna ist bald fertig geheizt\" auslösen soll."
              },
              "value": 10,
              "attr": {
                "min": 1,
                "max": 60,
                "step": 1
              },
              "units": {
                "en": "min",
                "de": "min"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Advanced",
            "de": "Erweitert"
          },
          "children": [
            {
              "id": "pollInterval",
              "type": "number",
              "label": {
                "en": "Status refresh interval (while heating)",
                "de": "Aktualisierungsintervall (während des Heizens)"
              },
              "hint": {
                "en": "How often the app fetches the sauna's status from the HUUM cloud while it's heating.",
                "de": "Wie oft die App den Sauna-Status aus der HUUM-Cloud abruft, während sie heizt."
              },
              "value": 30,
              "attr": {
                "min": 10,
                "max": 300,
                "step": 5
              },
              "units": {
                "en": "sec",
                "de": "Sek."
              }
            },
            {
              "id": "idlePollInterval",
              "type": "number",
              "label": {
                "en": "Status refresh interval (while idle)",
                "de": "Aktualisierungsintervall (im Standby)"
              },
              "hint": {
                "en": "How often the app checks in while the heater is off — slower on purpose to go easy on the HUUM cloud. A capability change (e.g. turning it on) always refreshes immediately regardless of this setting.",
                "de": "Wie oft die App nachfragt, während der Ofen aus ist — bewusst langsamer, um die HUUM-Cloud zu schonen. Eine Aktion (z. B. Einschalten) aktualisiert unabhängig davon immer sofort."
              },
              "value": 300,
              "attr": {
                "min": 60,
                "max": 1800,
                "step": 30
              },
              "units": {
                "en": "sec",
                "de": "Sek."
              }
            },
            {
              "id": "heaterPowerKw",
              "type": "number",
              "label": {
                "en": "Heater power (for Energy estimate)",
                "de": "Ofenleistung (für Energieschätzung)"
              },
              "hint": {
                "en": "The rated power of your HUUM heater in kW, as printed on its label. The HUUM API does not report real power draw, so Homey's Energy tab uses this to estimate consumption while heating.",
                "de": "Die Nennleistung deines HUUM-Ofens in kW (siehe Typenschild). Die HUUM-API liefert keinen echten Stromverbrauch, daher nutzt Homeys Energie-Tab diesen Wert zur Schätzung während des Heizens."
              },
              "value": 6,
              "attr": {
                "min": 1,
                "max": 15,
                "step": 0.5
              },
              "units": {
                "en": "kW",
                "de": "kW"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Sauna info (read-only)",
            "de": "Sauna-Info (nur Anzeige)"
          },
          "children": [
            {
              "id": "currentStatus",
              "type": "label",
              "label": {
                "en": "Status",
                "de": "Status"
              },
              "hint": {
                "en": "The heater's raw status, including states not otherwise shown anywhere in the app (e.g. \"in use by another user\").",
                "de": "Der Rohstatus des Ofens, inklusive Zuständen, die sonst nirgends in der App angezeigt werden (z. B. \"von anderem Nutzer in Benutzung\")."
              },
              "value": "-"
            },
            {
              "id": "steamerInstalled",
              "type": "label",
              "label": {
                "en": "Steamer connected",
                "de": "Verdampfer angeschlossen"
              },
              "hint": {
                "en": "Detected from the sauna's own configuration report. If a steamer is detected, the humidity capabilities and no-water alarm are added automatically; if not, they're hidden.",
                "de": "Wird aus der Konfigurationsmeldung der Sauna erkannt. Ist ein Verdampfer vorhanden, werden Luftfeuchtigkeits-Funktionen und Wasseralarm automatisch hinzugefügt — falls nicht, bleiben sie ausgeblendet."
              },
              "value": "-"
            },
            {
              "id": "lightInstalled",
              "type": "label",
              "label": {
                "en": "Light/fan connected",
                "de": "Licht/Lüfter angeschlossen"
              },
              "value": "-"
            },
            {
              "id": "childLock",
              "type": "label",
              "label": {
                "en": "Child lock",
                "de": "Kindersicherung"
              },
              "value": "-"
            },
            {
              "id": "remoteSafetyState",
              "type": "label",
              "label": {
                "en": "Remote safety state",
                "de": "Fernsicherheitsstatus"
              },
              "value": "-"
            },
            {
              "id": "paymentEndDate",
              "type": "label",
              "label": {
                "en": "Subscription valid until",
                "de": "Abo gültig bis"
              },
              "value": "-"
            },
            {
              "id": "deviceLimits",
              "type": "label",
              "label": {
                "en": "Reported temperature/timer limits",
                "de": "Gemeldete Temperatur-/Timer-Grenzen"
              },
              "value": "-"
            }
          ]
        }
      ]
    }
  ]
}
