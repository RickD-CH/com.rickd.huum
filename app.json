{
  "_comment": "This file is generated by hand for a from-scratch Homey SDK3 app. Edit this file, not a compose build output.",
  "id": "com.rickd.huum",
  "version": "0.7.4",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "HUUM UKU Sauna",
    "de": "HUUM UKU Sauna"
  },
  "description": {
    "en": "Full sauna control — humidity, water alarm, timer and more — that the official app leaves out.",
    "de": "Volle Saunasteuerung — Luftfeuchtigkeit, Wasseralarm, Timer und mehr — die die offizielle App auslässt."
  },
  "category": ["climate"],
  "permissions": ["homey:manager:api"],
  "api": {
    "getOverview": { "method": "get", "path": "/overview" },
    "refreshOverview": { "method": "post", "path": "/overview/refresh" },
    "getDeviceConfig": { "method": "get", "path": "/device/:id/config" },
    "setDeviceConfig": { "method": "put", "path": "/device/:id/config" },
    "getPowerMeters": { "method": "get", "path": "/power-meters" }
  },
  "widgets": {
    "sauna": {
      "id": "sauna",
      "name": { "en": "Sauna", "de": "Sauna" },
      "settings": [],
      "height": 132,
      "api": {
        "getState": { "method": "GET", "path": "/state" },
        "setPower": { "method": "POST", "path": "/power" },
        "startProfile": { "method": "POST", "path": "/profile" }
      }
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Richard Dubs"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "RickDch"
      }
    }
  },
  "brandColor": "#E85D2B",
  "source": "https://github.com/RickD-CH/com.rickd.huum",
  "bugs": {
    "url": "https://github.com/RickD-CH/com.rickd.huum/issues"
  },
  "capabilities": {
    "huum_time_remaining": {
      "type": "number",
      "icon": "/assets/huum_time_remaining.svg",
      "title": {
        "en": "Time Remaining",
        "de": "Verbleibende Zeit"
      },
      "desc": {
        "en": "Minutes remaining until the heater automatically switches off.",
        "de": "Minuten, bis der Ofen automatisch ausschaltet."
      },
      "units": {
        "en": "min",
        "de": "min"
      },
      "min": 0,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "huum_session_count": {
      "type": "number",
      "icon": "/assets/huum_session_count.svg",
      "title": {
        "en": "Sessions",
        "de": "Sitzungen"
      },
      "desc": {
        "en": "Number of completed sauna sessions since pairing.",
        "de": "Anzahl abgeschlossener Sauna-Sitzungen seit dem Koppeln."
      },
      "min": 0,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "huum_refresh": {
      "type": "boolean",
      "title": {
        "en": "Refresh now",
        "de": "Jetzt aktualisieren"
      },
      "desc": {
        "en": "Pull a fresh reading from HUUM right now instead of waiting for the next poll.",
        "de": "Sofort einen frischen Wert von HUUM holen, statt auf den nächsten Abruf zu warten."
      },
      "getable": false,
      "setable": true,
      "uiComponent": "button",
      "uiQuickAction": false
    },
    "huum_remote_blocked": {
      "type": "boolean",
      "icon": "/assets/huum_remote_blocked.svg",
      "title": {
        "en": "Remote start blocked",
        "de": "Fernstart blockiert"
      },
      "desc": {
        "en": "The UKU requires someone to confirm safety on the physical panel before it will accept a remote start — separate from whether the door is open.",
        "de": "Die UKU verlangt, dass jemand die Sicherheit am Bedienfeld bestätigt, bevor ein Fernstart akzeptiert wird — unabhängig davon, ob die Tür offen ist."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "huum_start_profile": {
      "type": "enum",
      "title": {
        "en": "Start with",
        "de": "Starten mit"
      },
      "desc": {
        "en": "Which profile to use when the sauna is switched on from the device.",
        "de": "Welches Profil beim Einschalten am Gerät verwendet wird."
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        { "id": "manual", "title": { "en": "Last settings", "de": "Letzte Einstellung" } },
        { "id": "profile1", "title": { "en": "Profile 1", "de": "Profil 1" } },
        { "id": "profile2", "title": { "en": "Profile 2", "de": "Profil 2" } },
        { "id": "profile3", "title": { "en": "Profile 3", "de": "Profil 3" } }
      ]
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "remote_control_blocked",
        "title": {
          "en": "Remote start became blocked",
          "de": "Fernstart wurde blockiert"
        },
        "hint": {
          "en": "The UKU now requires someone to confirm safety on the physical panel before it will accept a remote start.",
          "de": "Die UKU verlangt jetzt, dass jemand die Sicherheit am Bedienfeld bestätigt, bevor ein Fernstart akzeptiert wird."
        },
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=uku" }
        ]
      },
      {
        "id": "remote_control_available",
        "title": {
          "en": "Remote start became available",
          "de": "Fernstart wurde wieder möglich"
        },
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=uku" }
        ]
      },
      {
        "id": "current_temperature_changed",
        "title": {
          "en": "The current temperature changed",
          "de": "Die aktuelle Temperatur hat sich geändert"
        },
        "hint": {
          "en": "Homey doesn't offer this for measure_temperature by default, only threshold cards — this fires on every change.",
          "de": "Homey bietet dies für measure_temperature standardmäßig nicht an, nur Schwellenwert-Karten — dieser Trigger feuert bei jeder Änderung."
        },
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=uku" }
        ],
        "tokens": [
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature (°C)",
              "de": "Temperatur (°C)"
            },
            "example": 78
          }
        ]
      },
      {
        "id": "huum_finishing_soon",
        "title": {
          "en": "The sauna will be done heating soon",
          "de": "Die Sauna ist bald fertig geheizt"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          }
        ],
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes remaining",
              "de": "Verbleibende Minuten"
            },
            "example": 8
          }
        ]
      },
      {
        "id": "sauna_session_ended",
        "title": {
          "en": "A sauna session ended",
          "de": "Eine Sauna-Sitzung ist beendet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          }
        ],
        "tokens": [
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration (minutes)",
              "de": "Dauer (Minuten)"
            },
            "example": 103
          },
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature (°C)",
              "de": "Temperatur (°C)"
            },
            "example": 85
          },
          {
            "name": "humidity",
            "type": "number",
            "title": {
              "en": "Humidity (%, 0 if no steamer)",
              "de": "Luftfeuchtigkeit (%, 0 ohne Verdampfer)"
            },
            "example": 25
          },
          {
            "name": "kwh",
            "type": "number",
            "title": {
              "en": "Energy used (kWh)",
              "de": "Verbrauch (kWh)"
            },
            "example": 8.4
          },
          {
            "name": "cost",
            "type": "number",
            "title": {
              "en": "Cost (0 if no price set)",
              "de": "Kosten (0 ohne Preisangabe)"
            },
            "example": 2.9
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "time_remaining_below",
        "title": {
          "en": "Remaining time !{{is|is not}} below",
          "de": "Restzeit !{{ist|ist nicht}} unter"
        },
        "titleFormatted": {
          "en": "Remaining time !{{is|is not}} below [[minutes]] minutes",
          "de": "Restzeit !{{ist|ist nicht}} unter [[minutes]] Minuten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Minutes",
              "de": "Minuten"
            },
            "min": 1,
            "max": 180,
            "value": 10
          }
        ]
      },
      {
        "id": "remote_control_is_blocked",
        "title": {
          "en": "Remote start !{{is|is not}} blocked",
          "de": "Fernstart !{{ist|ist nicht}} blockiert"
        },
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=uku" }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_measured_power",
        "title": {
          "en": "Set the sauna's measured power",
          "de": "Gemessene Sauna-Leistung setzen"
        },
        "titleFormatted": {
          "en": "Set the sauna's measured power to [[watts]] W",
          "de": "Gemessene Sauna-Leistung auf [[watts]] W setzen"
        },
        "hint": {
          "en": "Feeds a power reading (e.g. from your own energy meter) into this device for the Energy tab and the per-session cost. Set the heater power source to \"From a Flow\" in the app settings first.",
          "de": "Speist einen Leistungswert (z. B. von deinem eigenen Stromzähler) in dieses Gerät ein — für den Energie-Tab und die Kosten pro Sitzung. Stelle in den App-Einstellungen zuerst die Leistungsquelle auf \"Aus einem Flow\"."
        },
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=uku" },
          {
            "type": "number",
            "name": "watts",
            "title": { "en": "Watts", "de": "Watt" },
            "min": 0,
            "max": 30000,
            "step": 1
          }
        ]
      },
      {
        "id": "start_with_temperature_and_humidity",
        "title": {
          "en": "Start the sauna at a temperature and humidity",
          "de": "Sauna mit Temperatur und Luftfeuchtigkeit starten"
        },
        "titleFormatted": {
          "en": "Start the sauna at [[temperature]] °C and [[humidity]] % humidity",
          "de": "Sauna mit [[temperature]] °C und [[humidity]] % Luftfeuchtigkeit starten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "range",
            "name": "temperature",
            "title": {
              "en": "Temperature (°C)",
              "de": "Temperatur (°C)"
            },
            "min": 40,
            "max": 110,
            "step": 1,
            "value": 80,
            "label": "°C"
          },
          {
            "type": "range",
            "name": "humidity",
            "title": {
              "en": "Humidity (%)",
              "de": "Luftfeuchtigkeit (%)"
            },
            "min": 0,
            "max": 90,
            "step": 5,
            "value": 30,
            "label": "%"
          }
        ]
      },
      {
        "id": "start_with_profile",
        "title": {
          "en": "Start the sauna with a profile",
          "de": "Sauna mit einem Profil starten"
        },
        "titleFormatted": {
          "en": "Start the sauna with profile [[profile]]",
          "de": "Sauna mit Profil [[profile]] starten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "dropdown",
            "name": "profile",
            "title": {
              "en": "Profile",
              "de": "Profil"
            },
            "values": [
              { "id": "profile1", "title": { "en": "Profile 1", "de": "Profil 1" } },
              { "id": "profile2", "title": { "en": "Profile 2", "de": "Profil 2" } },
              { "id": "profile3", "title": { "en": "Profile 3", "de": "Profil 3" } }
            ]
          }
        ]
      },
      {
        "id": "save_profile",
        "title": {
          "en": "Save the current settings as a profile",
          "de": "Aktuelle Einstellungen als Profil speichern"
        },
        "titleFormatted": {
          "en": "Save the current settings as profile [[profile]]",
          "de": "Aktuelle Einstellungen als Profil [[profile]] speichern"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "dropdown",
            "name": "profile",
            "title": {
              "en": "Profile",
              "de": "Profil"
            },
            "values": [
              { "id": "profile1", "title": { "en": "Profile 1", "de": "Profil 1" } },
              { "id": "profile2", "title": { "en": "Profile 2", "de": "Profil 2" } },
              { "id": "profile3", "title": { "en": "Profile 3", "de": "Profil 3" } }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "uku",
      "name": {
        "en": "Sauna heater",
        "de": "Saunaofen"
      },
      "class": "heater",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature.room",
        "target_humidity",
        "measure_humidity",
        "huum_start_profile",
        "huum_refresh",
        "measure_power",
        "huum_time_remaining",
        "huum_session_count",
        "alarm_contact",
        "alarm_water",
        "alarm_generic",
        "huum_remote_blocked"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 40,
          "max": 110,
          "step": 1,
          "decimals": 0,
          "uiComponent": "thermostat",
          "title": {
            "en": "Target temperature",
            "de": "Zieltemperatur"
          }
        },
        "measure_temperature.room": {
          "uiComponent": "sensor",
          "title": {
            "en": "Current temperature",
            "de": "Aktuelle Temperatur"
          }
        },
        "measure_power": {
          "title": {
            "en": "Power (from linked meter)",
            "de": "Leistung (vom verknüpften Messgerät)"
          }
        },
        "target_humidity": {
          "min": 0,
          "max": 0.9,
          "step": 0.05,
          "uiComponent": "thermostat",
          "title": {
            "en": "Target humidity",
            "de": "Zielfeuchte"
          }
        },
        "measure_humidity": {
          "decimals": 0,
          "title": {
            "en": "Current humidity",
            "de": "Aktuelle Feuchte"
          }
        },
        "alarm_contact": {
          "title": {
            "en": "Door open",
            "de": "Tür offen"
          }
        },
        "alarm_water": {
          "title": {
            "en": "No water in steamer",
            "de": "Kein Wasser im Verdampfer"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Safety cut-out / fault",
            "de": "Sicherheitsabschaltung / Störung"
          }
        },
        "onoff.light": {
          "title": {
            "en": "Light",
            "de": "Licht"
          }
        }
      },
      "energy": {
        "approximation": {
          "usageOn": 6000,
          "usageOff": 0
        }
      },
      "platforms": ["local"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/uku/assets/images/small.png",
        "large": "/drivers/uku/assets/images/large.png",
        "xlarge": "/drivers/uku/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "/drivers/uku/assets/icon.svg",
            "usernameLabel": {
              "en": "HUUM email address",
              "de": "HUUM E-Mail-Adresse"
            },
            "usernameHint": {
              "en": "The email address you use to log in to the HUUM app.",
              "de": "Die E-Mail-Adresse, mit der du dich in der HUUM-App anmeldest."
            },
            "passwordLabel": {
              "en": "HUUM password",
              "de": "HUUM Passwort"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "HUUM email address",
              "de": "HUUM E-Mail-Adresse"
            },
            "passwordLabel": {
              "en": "HUUM password",
              "de": "HUUM Passwort"
            }
          }
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Notifications",
            "de": "Benachrichtigungen"
          },
          "children": [
            {
              "id": "notifyOnWaterAlarm",
              "type": "checkbox",
              "label": {
                "en": "Push notification when the steamer has no water",
                "de": "Push-Benachrichtigung, wenn dem Verdampfer Wasser fehlt"
              },
              "hint": {
                "en": "Sends a Homey notification the moment the steamer reports it needs to be refilled, in addition to the water alarm you can use in Flows. Only works if your steamer has a water-level sensor (see Sensors / hardware).",
                "de": "Sendet eine Homey-Benachrichtigung, sobald der Verdampfer meldet, dass Wasser nachgefüllt werden muss — zusätzlich zum Wasseralarm, den du auch in Flows nutzen kannst. Funktioniert nur, wenn dein Verdampfer einen Wasserstandssensor hat (siehe Sensoren / Hardware)."
              },
              "value": true
            },
            {
              "id": "showWarningBanner",
              "type": "checkbox",
              "label": {
                "en": "Show a warning banner on the device",
                "de": "Warnbanner am Gerät anzeigen"
              },
              "hint": {
                "en": "Shows the orange banner (\"remote control disabled\", \"door is open\") on the device page. Homey's warning banners can't be dismissed by hand — they clear on their own once the condition is gone. Turn this off to hide it entirely.",
                "de": "Zeigt das orange Banner (\"Fernsteuerung deaktiviert\", \"Tür ist offen\") auf der Geräteseite. Homeys Warnbanner lassen sich nicht von Hand schließen — sie verschwinden von selbst, sobald die Ursache weg ist. Hier ausschalten, um es ganz auszublenden."
              },
              "value": true
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Sensors / hardware",
            "de": "Sensoren / Hardware"
          },
          "children": [
            {
              "id": "waterSensorMode",
              "type": "dropdown",
              "label": {
                "en": "Water-level sensor",
                "de": "Wasserstandssensor"
              },
              "hint": {
                "en": "Whether your steamer has a water-level sensor wired up. \"Automatic\" trusts what the HUUM API reports. Choose \"Not connected\" if your sauna has none — the no-water alarm is then hidden (it could never fire anyway); use the reminder below instead.",
                "de": "Ob dein Verdampfer einen Wasserstandssensor hat. \"Automatisch\" vertraut der HUUM-API. Wähle \"Nicht angeschlossen\", wenn deine Sauna keinen hat — der Wasseralarm wird dann ausgeblendet (er könnte ohnehin nie auslösen); nutze stattdessen die Erinnerung unten."
              },
              "value": "auto",
              "values": [
                { "id": "auto", "label": { "en": "Automatic (trust the API)", "de": "Automatisch (API vertrauen)" } },
                { "id": "present", "label": { "en": "Connected", "de": "Angeschlossen" } },
                { "id": "absent", "label": { "en": "Not connected", "de": "Nicht angeschlossen" } }
              ]
            },
            {
              "id": "doorSensorMode",
              "type": "dropdown",
              "label": {
                "en": "Door sensor",
                "de": "Türsensor"
              },
              "hint": {
                "en": "Whether your sauna has a door contact sensor. Choose \"Not connected\" to hide the door alarm and skip the \"don't start with the door open\" safety check — otherwise a heater that always reports the door as open could never be started.",
                "de": "Ob deine Sauna einen Türkontakt hat. Wähle \"Nicht angeschlossen\", um den Türalarm auszublenden und die Sicherheitsprüfung \"nicht bei offener Tür starten\" zu überspringen — sonst könnte ein Ofen, der die Tür immer als offen meldet, nie gestartet werden."
              },
              "value": "auto",
              "values": [
                { "id": "auto", "label": { "en": "Automatic (trust the API)", "de": "Automatisch (API vertrauen)" } },
                { "id": "present", "label": { "en": "Connected", "de": "Angeschlossen" } },
                { "id": "absent", "label": { "en": "Not connected", "de": "Nicht angeschlossen" } }
              ]
            },
            {
              "id": "waterCheckReminder",
              "type": "checkbox",
              "label": {
                "en": "Remind me to check the water before heating",
                "de": "Vor dem Heizen an Wasser-Kontrolle erinnern"
              },
              "hint": {
                "en": "Sends a Homey notification every time the sauna is switched on (from the app or a Flow), asking you to check the steamer water first. A manual stand-in for the water alarm when there is no water sensor.",
                "de": "Sendet jedes Mal, wenn die Sauna eingeschaltet wird (per App oder Flow), eine Homey-Benachrichtigung mit der Bitte, zuerst das Verdampferwasser zu prüfen. Ein manueller Ersatz für den Wasseralarm, wenn kein Wassersensor vorhanden ist."
              },
              "value": false
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Sauna info (read-only)",
            "de": "Sauna-Info (nur Anzeige)"
          },
          "children": [
            {
              "id": "currentStatus",
              "type": "label",
              "label": {
                "en": "Status",
                "de": "Status"
              },
              "hint": {
                "en": "The heater's raw status, including states not otherwise shown anywhere in the app (e.g. \"in use by another user\").",
                "de": "Der Rohstatus des Ofens, inklusive Zuständen, die sonst nirgends in der App angezeigt werden (z. B. \"von anderem Nutzer in Benutzung\")."
              },
              "value": "-"
            },
            {
              "id": "steamerInstalled",
              "type": "label",
              "label": {
                "en": "Steamer connected",
                "de": "Verdampfer angeschlossen"
