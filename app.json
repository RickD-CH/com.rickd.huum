{
  "_comment": "This file is generated by hand for a from-scratch Homey SDK3 app. Edit this file, not a compose build output.",
  "id": "com.rickd.huum",
  "version": "0.1.0",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": ["local", "cloud"],
  "name": {
    "en": "HUUM Sauna (Full Control)",
    "de": "HUUM Sauna (Volle Kontrolle)"
  },
  "description": {
    "en": "Control your HUUM UKU sauna heater, including target humidity — the one thing the official HUUM app can't set.",
    "de": "Steuert den HUUM UKU Saunaofen, inklusive Ziel-Luftfeuchtigkeit — genau das, was die offizielle HUUM-App nicht einstellen kann."
  },
  "category": ["climate"],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Ric Dubs",
    "email": "ric.dubs@gmail.com"
  },
  "brandColor": "#E85D2B",
  "source": "https://github.com/RickD-CH/com.rickd.huum",
  "bugs": {
    "url": "https://github.com/RickD-CH/com.rickd.huum/issues"
  },
  "flow": {
    "actions": [
      {
        "id": "start_with_temperature_and_humidity",
        "title": {
          "en": "Start the sauna at !{{|}} temperature and humidity",
          "de": "Sauna mit Temperatur und Luftfeuchtigkeit starten"
        },
        "titleFormatted": {
          "en": "Start the sauna at [[temperature]] °C and [[humidity]] % humidity",
          "de": "Sauna mit [[temperature]] °C und [[humidity]] % Luftfeuchtigkeit starten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=uku"
          },
          {
            "type": "range",
            "name": "temperature",
            "title": {
              "en": "Temperature (°C)",
              "de": "Temperatur (°C)"
            },
            "min": 40,
            "max": 110,
            "step": 1,
            "value": 80,
            "label": "°C"
          },
          {
            "type": "range",
            "name": "humidity",
            "title": {
              "en": "Humidity (%)",
              "de": "Luftfeuchtigkeit (%)"
            },
            "min": 0,
            "max": 90,
            "step": 5,
            "value": 30,
            "label": "%"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "uku",
      "name": {
        "en": "HUUM UKU Sauna Heater",
        "de": "HUUM UKU Saunaofen"
      },
      "class": "thermostat",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "target_humidity",
        "measure_humidity",
        "alarm_contact"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 40,
          "max": 110,
          "step": 1,
          "decimals": 0
        },
        "target_humidity": {
          "min": 0,
          "max": 0.9,
          "step": 0.01
        },
        "alarm_contact": {
          "title": {
            "en": "Door open",
            "de": "Tür offen"
          }
        },
        "onoff.light": {
          "title": {
            "en": "Light",
            "de": "Licht"
          }
        }
      },
      "platforms": ["local", "cloud"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/uku/assets/images/small.png",
        "large": "/drivers/uku/assets/images/large.png",
        "xlarge": "/drivers/uku/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "/drivers/uku/assets/icon.svg",
            "usernameLabel": {
              "en": "HUUM email address",
              "de": "HUUM E-Mail-Adresse"
            },
            "usernameHint": {
              "en": "The email address you use to log in to the HUUM app.",
              "de": "Die E-Mail-Adresse, mit der du dich in der HUUM-App anmeldest."
            },
            "passwordLabel": {
              "en": "HUUM password",
              "de": "HUUM Passwort"
            }
          },
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "HUUM email address",
              "de": "HUUM E-Mail-Adresse"
            },
            "passwordLabel": {
              "en": "HUUM password",
              "de": "HUUM Passwort"
            }
          }
        }
      ]
    }
  ]
}
